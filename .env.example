# MinIO local development credentials
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-strong
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-strong

# compose 项目名（重要）
# 仓库目录名变更后（agent-lifeform -> ai-agent），compose 默认项目名随之变化，
# 会与既有容器/数据卷（agent-lifeform_*）命名冲突并可能创建空卷。
# 首次使用请复制本文件为 .env，并沿用既有项目名以复用容器与数据：
COMPOSE_PROJECT_NAME=agent-lifeform

# 工作平台 BFF：应用服务本地启停开关（生产建议 false；本机开发可 true）
WP_BFF_APP_CONTROL=true

# OpenRouter / OpenAI 兼容模型参数（仅示例，禁止提交真实 Key）
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
# 模型配置密文主密钥（生产必须通过密钥管理系统注入）
MODEL_CONFIG_MASTER_KEY=
# 开发默认允许本地密钥文件；生产必须设为 false，并强制注入上面的环境密钥
MODEL_CONFIG_ALLOW_LOCAL_KEY_FILE=true
# 开发默认允许 PG 不可用时进程内降级；生产必须设为 true，写失败直接返回 503
MODEL_CONFIG_REQUIRE_PERSISTENCE=false
# gateway-service -> wp-bff 的生产路由地址；容器部署时改为服务名或负载均衡地址
WP_BFF_URI=http://127.0.0.1:8090
