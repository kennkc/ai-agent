# 环境变量（含密钥，不入库）
# 仅 .env.example 作为模板入库；.env / .env.local / .env.production 等一律忽略
.env
.env.*
!.env.example
!web/work-platform/.env.test

# 构建产物
target/
__pycache__/
*.class
node_modules/
.next/
dist/

# 本地调试临时产物（诊断日志 / 基准脚本）
.build/

# 本地工作区（端到端验收脚本 / 临时产物）
.workbuddy/

# 感官采集运行时目录
data/sense-inbox/
data/sense-staging/

# IDE
.idea/
.vscode/
*.iml

# 日志
*.log
logs/

# Generated Python proto code
services/python/nlp-service/generated/

# Vite cache
**/.vite/

# Python 虚拟环境（本机 services/python/venv，34MB，不入库）
venv/
.venv/
services/python/venv/

# 模型配置的本地加密密钥（MODEL_CONFIG_MASTER_KEY 未设置时自动生成；**绝不能入库**）
# 生产环境必须改用环境变量注入，见 docs/模型接入配置.md
.model-config-key
services/python/nlp-service/.model-config-key

# 感官采集运行时目录（服务工作目录为 services/java，故相对路径带前缀）
services/java/data/

# Python 工具缓存（本地生成，不入库）
.pytest_cache/
.ruff_cache/

# Playwright\nweb/work-platform/playwright-report/
web/work-platform/test-results/playwright/
web/work-platform/coverage/
