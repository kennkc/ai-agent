# 环境变量（含密钥，不入库）
# 仅 .env.example 作为模板入库；.env / .env.local / .env.production 等一律忽略
.env
.env.*
!.env.example

# 构建产物
target/
__pycache__/
*.class
node_modules/
.next/
dist/

# 本地调试临时产物（诊断日志 / 基准脚本）
.build/

# 感官采集运行时目录
data/sense-inbox/
data/sense-staging/

# IDE
.idea/
.vscode/
*.iml

# 日志
*.log
logs/

# Generated Python proto code
services/python/nlp-service/generated/

# Vite cache
**/.vite/

# Python 虚拟环境（本机 services/python/venv，34MB，不入库）
venv/
.venv/
services/python/venv/

# 感官采集运行时目录（服务工作目录为 services/java，故相对路径带前缀）
services/java/data/
